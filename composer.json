{
    "name": "tobento/app",
    "version": "2.0.1",
    "type": "library",
    "description": "Base application for creating any PHP project.",
    "keywords": [
        "tobento",
        "package",
        "PHP",
        "application"
	],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "psr/container": "^2.0",
        "psr/clock": "^1.0",
        "tobento/service-macro": "^2.0",
        "tobento/service-helper-function": "^2.0",
        "tobento/service-error-handler": "^2.0",
        "tobento/service-resolver": "^2.0",
        "tobento/service-resolver-container": "^2.0",
        "tobento/service-dir": "^2.0",
        "tobento/service-booting": "^2.0",
        "tobento/service-clock": "^2.0",
        "tobento/service-collection": "^2.0",
        "tobento/service-config": "^2.0",
        "tobento/service-dater": "^2.0"
    },  
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\App\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\App\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}